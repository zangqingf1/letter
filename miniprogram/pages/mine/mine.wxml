<!-- 09 · 我的（Tab 2）：个人名片 + 2×2 便签统计 + 数量行 + 功能列表 -->
<view class="page" style="padding-top: {{statusBarHeight}}px;">

  <!-- 顶部品牌区：与首页信匣一致的 logo + 名称（位置大小不变） -->
  <view class="home-head">
    <image class="logo" src="/assets/logo.png" mode="aspectFit" />
    <image class="brand-name" src="/assets/name.png" mode="aspectFit" />
  </view>

  <!-- 顶部用户资料区：贴在最顶部的「个人名片信封」，点击进入账号管理 -->
  <!-- 资料未就位（冷启动且预热未完成）时用等宽占位条撑住版面，不显示空名片 -->
  <view class="profile-card" hover-class="profile-card-hover" bindtap="onTapAccount">
    <view class="avatar">
      <image wx:if="{{user.avatar}}" class="avatar-img" src="{{user.avatar}}" mode="aspectFill" />
      <text wx:elif="{{profileReady}}" class="avatar-char">{{avatarChar}}</text>
      <view wx:else class="skeleton skeleton-avatar"></view>
    </view>
    <view class="profile-info">
      <view wx:if="{{profileReady}}" class="nickname">{{user.nickname}}</view>
      <view wx:else class="skeleton skeleton-nickname"></view>
      <view wx:if="{{profileReady}}" class="wrote-days">在这个匣子里写了 <text class="days-num">{{user.wroteDays}}</text> 天</view>
      <view wx:else class="skeleton skeleton-days"></view>
    </view>
    <text class="profile-arrow">›</text>
  </view>

  <!-- 2×2 手作便签统计区（数值未就位时显示 — 占位，版面不跳动） -->
  <view class="section-label">统计概览</view>
  <view class="notes">
    <view
      class="note"
      wx:for="{{notes}}"
      wx:key="name"
      style="transform: rotate({{item.tilt}}deg);"
    >
      <view class="note-name">{{item.name}}</view>
      <view class="note-line"></view>
      <view class="note-num"><text class="note-value{{statsReady ? '' : ' note-value-pending'}}">{{item.value}}</text> {{item.unit}}</view>
    </view>
  </view>

  <!-- 回形针与废纸篓数量行：别着回形针的纸条 -->
  <view class="count-bar">
    <view class="count-item" hover-class="count-item-hover" bindtap="onTapPaperclip">
      <text class="count-emoji">📎</text>
      <text class="count-text">回形针优先展示</text>
      <text class="count-num">({{statsReady ? pinnedCount : '—'}})</text>
    </view>
    <view class="count-divider"></view>
    <view class="count-item" hover-class="count-item-hover" bindtap="onTapRecycle">
      <text class="count-emoji">🗑️</text>
      <text class="count-text">废纸篓</text>
      <text class="count-num">({{statsReady ? recycleCount : '—'}})</text>
    </view>
  </view>

  <!-- 会员中心：金调高亮入口行（付费 VIP，真实虚拟支付） -->
  <view class="member-entry" hover-class="member-entry-hover" bindtap="onTapMember">
    <view class="member-entry-icon">VIP</view>
    <view class="member-entry-body">
      <view class="member-entry-title">会员中心</view>
      <view class="member-entry-desc">专属信纸与主题 · 信封不限量</view>
    </view>
    <text class="member-entry-arrow">›</text>
  </view>

  <!-- 底部功能列表：无硬体分割，浅色信纸下划线分隔，无多余图标 -->
  <view class="menu">
    <view class="menu-item" hover-class="menu-item-hover" bindtap="onTapFeedback">
      <text class="menu-text">问题反馈</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" hover-class="menu-item-hover" bindtap="onTapAbout">
      <text class="menu-text">关于心灵信箱</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

</view>
