<!-- 10 · 账号管理（从「我的」页名片进入）：资料区（微信头像昵称填写能力）+ 账号注销 -->
<view class="page" style="padding-top: {{statusBarHeight}}px;">

  <!-- 顶部轻导航：‹ 我的 + 居中标题 -->
  <view class="nav">
    <view class="nav-back" hover-class="nav-back-hover" bindtap="onTapBack">‹ 我的</view>
    <view class="nav-title">账号管理</view>
  </view>

  <!-- 资料区：头像（open-type="chooseAvatar"）+ 昵称（type="nickname" 输入框） -->
  <view class="profile-card">
    <view class="avatar-wrap">
      <image wx:if="{{profile.avatar}}" class="avatar-img" src="{{profile.avatar}}" mode="aspectFill" />
      <text wx:else class="avatar-char">{{avatarChar}}</text>
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" hover-class="avatar-btn-hover"></button>
      <view class="avatar-tip">点击更换</view>
    </view>
    <view class="profile-info">
      <input
        class="nickname-input"
        type="nickname"
        value="{{profile.nickname}}"
        placeholder="填写昵称"
        placeholder-class="nickname-placeholder"
        maxlength="16"
        bindblur="onNicknameBlur"
        bindconfirm="onNicknameBlur"
      />
      <view class="wrote-days">在这个匣子里写了 <text class="days-num">{{wroteDays}}</text> 天</view>
    </view>
  </view>

  <!-- 个人资料：生日（月/日两列选择器，不收出生年份；非法值云函数侧丢弃） -->
  <view class="section-label">个人资料</view>
  <view class="menu">
    <picker
      mode="multiSelector"
      range="{{birthdayRange}}"
      value="{{birthdayIndex}}"
      bindcolumnchange="onBirthdayColumn"
      bindchange="onBirthdayPick"
    >
      <view class="menu-item" hover-class="menu-item-hover">
        <text class="menu-text-strong">生日</text>
        <view class="birthday-value-wrap">
          <text class="birthday-value {{birthdayText ? '' : 'birthday-empty'}}">{{birthdayText || '选择月 · 日'}}</text>
          <text wx:if="{{birthdayText}}" class="birthday-clear" catchtap="onBirthdayClear">清除</text>
        </view>
      </view>
    </picker>
  </view>

  <!-- 账号操作区 -->
  <view class="section-label">账号</view>
  <view class="menu">
    <view class="menu-item" hover-class="menu-item-hover" bindtap="onTapDeactivate">
      <text class="menu-text">账号注销</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

</view>
