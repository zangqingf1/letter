/* 12 · 问题反馈：表单卡（文字 + 联系方式 + 多图截图），顶部轻导航与账号管理页同款 */
.page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--color-base-light);
}

/* ── 顶部轻导航：‹ 我的 + 居中标题 ── */
.nav {
  position: relative;
  flex: none;
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}
.nav-back {
  font-size: 28rpx;
  color: var(--color-text-primary);
  padding: 8rpx 0;
}
.nav-back-hover {
  opacity: 0.6;
}
.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-family: var(--font-heading);
  font-size: 32rpx;
  font-weight: 700;
}
/* 页首轻量说明 */
.page-note {
  margin: 8rpx 32rpx 20rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  letter-spacing: 2rpx;
}

/* ── 反馈表单卡 ── */
.card {
  margin: 12rpx 32rpx 0;
  background: var(--color-base-surface);
  border-radius: 36rpx;
  padding: 36rpx 32rpx;
  box-shadow: var(--shadow-warm-sm);
}
.field-label {
  margin: 36rpx 0 16rpx;
  font-size: 24rpx;
  color: var(--color-text-primary);
  letter-spacing: 2rpx;
}
.required {
  color: #B4553F;
  margin-left: 4rpx;
}
.ph {
  color: var(--color-text-secondary);
}
.content-input {
  width: 100%;
  min-height: 200rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--color-text-primary);
  background: var(--color-base-light);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}
.count {
  text-align: right;
  font-size: 20rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}
.contact-input {
  width: 100%;
  box-sizing: border-box;
  height: 76rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
  background: var(--color-base-light);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 0 24rpx;
}

/* ── 截图三列网格 ── */
.shots {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 4rpx;
}
.shot {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--color-base-light);
}
.shot-img {
  width: 100%;
  height: 100%;
  display: block;
}
.shot-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(46, 51, 48, 0.6);
  color: #fff;
  font-size: 24rpx;
}
.shot-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed var(--line);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: var(--color-text-secondary);
}
.shot-add-hover {
  opacity: 0.7;
}
.shot-tip {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

/* ── 提交按钮（复用全局 btn-primary） ── */
.submit-btn {
  margin: 48rpx 32rpx 0;
}
.submit-disabled {
  opacity: 0.6;
}
