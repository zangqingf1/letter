<!-- 03 · 信件详情 / 拆信阅读 / 回信（三个状态：多次拆开 / 首次拆开 / 回信弹层）
     页面背景随主题：desk 桌面色与拆信幕同源 —— 拆开后的阅读环境就是这封信的主题氛围；
     无交接/读取失败时 BLANK_THEME 不带 desk，回落中性 #F4F3EE（与历史观感一致） -->
<import src="../../styles/paper.wxml" />
<view class="page" style="padding-top: {{statusBarHeight}}px; background: {{theme.desk || '#F4F3EE'}};">

  <!-- 顶部轻导航：返回信匣 -->
  <view class="nav">
    <view class="nav-back" hover-class="nav-back-hover" bindtap="onTapBack">‹ 信匣</view>
  </view>

  <!-- 可滚动主容器：主信纸 → 重读记录（邮戳墙） → 回信便签 -->
  <scroll-view class="body" scroll-y>
    <view class="body-inner">

      <!-- 主信纸区：信纸自持版式（二十一款，papers.js 配置），
           共享模板与写信预览/分享图完全同构；写于落款 -->
      <template is="paper-letter" data="{{ v: view, paper: paper }}" />

      <!-- 重读记录（邮戳墙 · 戳痕成行）：系统自动产生，不可编辑/删除单条（BR-09） -->
      <view class="sect">
        <view class="ph-h">
          <text class="ph-no">01</text>
          <text class="ph-t">重读记录</text>
          <text class="ph-sub">{{openCount}} 次</text>
        </view>
        <view class="stampline {{stampsExpanded ? 'expanded' : ''}}">
          <view class="postmarks">
            <view wx:for="{{stamps}}" wx:key="ts" class="postmark {{item.today ? 'today' : ''}}">
              <text class="pm-date">{{item.date}}</text>
              <text wx:if="{{item.label}}" class="pm-label">{{item.label}}</text>
            </view>
            <view wx:if="{{moreChip}}" class="postmark more" bindtap="onToggleStamps">
              <text class="pm-date">+{{moreChip.count}}</text>
              <text class="pm-label">{{stampsExpanded ? '收起' : '展开'}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 回信便签区（戳痕成行：mono 编目 + 胶带便签流，日期自动生成不可改） -->
      <view class="sect">
        <view class="ph-h">
          <text class="ph-no">02</text>
          <text class="ph-t">回信</text>
          <text class="ph-sub">{{replyCount}} 封</text>
        </view>
        <view wx:for="{{replies}}" wx:key="ts" class="reply-note {{index % 2 === 0 ? 'r1' : 'r2'}}">
          <view class="rd-row">
            <text class="rd-no">{{item.no}}</text>
            <text class="rd-date">{{item.dateShort}}</text>
            <view class="reply-del" hover-class="reply-del-hover" data-ts="{{item.ts}}" catchtap="onTapReplyDelete">撕掉</view>
          </view>
          <view class="rb">{{item.text}}</view>
        </view>
      </view>

      <!-- 回信引导入口（陶土色虚线框触发块） -->
      <view class="reply-cta" hover-class="reply-cta-hover" bindtap="onOpenReply">
        ✍️ 又用到这封信？写下这次的感觉 →
      </view>

      <view class="body-space"></view>
    </view>
  </scroll-view>

  <!-- 底部悬浮操作栏（毛玻璃独立底板）：编辑 / 回形针 / 分享 / 删除 -->
  <view class="detail-ops">
    <view class="op" hover-class="op-hover" bindtap="onTapEdit">
      <view class="oi">✏️</view><view class="ol">编辑</view>
    </view>
    <view class="op {{pinned ? 'on' : ''}}" hover-class="op-hover" bindtap="onTogglePin">
      <view class="oi">📎</view><view class="ol">回形针</view>
    </view>
    <view class="op" hover-class="op-hover" bindtap="onTapShare">
      <view class="oi">📤</view><view class="ol">分享</view>
    </view>
    <view class="op" hover-class="op-hover" bindtap="onTapDelete">
      <view class="oi">🗑</view><view class="ol">丢弃</view>
    </view>
  </view>

</view>

<!-- 阶段一：拆信动画（约 1.2s，点击任意处跳过）：
     信封微浮起 → 信纸从信封中抽出并展开 → 信封淡出移出屏幕。
     背景随主题：desk 是该主题的桌面底色（信匣预览区同源）；无交接时 BLANK_THEME
     没有 desk，回落中性 #EDE9DC（= 默认款的 desk，视觉不变，不提前亮出主题） -->
<view wx:if="{{opening}}" class="unseal" style="background: {{theme.desk || '#EDE9DC'}};" bindtap="onSkipOpen">
  <view class="us-stage">
    <view class="us-paper" style="background: {{theme.palette.base}};">
      <view class="us-paper-headline"></view>
      <view class="us-paper-line" wx:for="{{[1,2,3,4,5,6]}}" wx:key="*this"></view>
    </view>
    <view class="us-env">
      <!-- 信封只能画这封信真正的主题：envSrc 由详情页给出 —— 入口页跳转前就把主题
           交接过来（services/handoff.js），并在点按瞬间预取了两级素材（home/clips 的
           .env-pre 节点），首帧是列表页刚渲染过的小图（图片缓存命中，第一帧就有信封），
           大图由下面那个屏幕外的节点加载完顶上。
           没有交接时（外部直接打开本页）留空，等云函数，绝不凭空亮出小王子。
           云端素材（cloud://）加载有网络延迟：envFade 挂载即透明，bindload 后淡入浮现，
           包内素材不挂 fade、首帧即完整呈现。见 detail.js 的 BLANK_THEME / envPatchOf -->
      <image wx:if="{{envSrc}}" class="us-env-img {{envFade ? 'fade' : ''}} {{envIn ? 'in' : ''}}" src="{{envSrc}}" mode="widthFix" bindload="onEnvImgLoad" />
      <!-- 大图预取：放到屏幕外只为触发加载，加载完由 onEnvFullLoaded 换掉上面的小图 -->
      <image wx:if="{{envFull}}" class="us-env-pre" src="{{envFull}}" mode="widthFix" bindload="onEnvFullLoaded" />
      <view class="us-env-name">{{letter.name}}</view>
      <view class="us-stamp">
        <text class="us-stamp-date">{{openStampText}}</text>
        <text class="us-stamp-label">重读邮戳</text>
      </view>
    </view>
  </view>
  <view class="us-hint">轻触任意处跳过</view>
</view>

<!-- 回信弹层：半屏便签抽屉（40% 遮罩，日期固定不可改，手写体多行输入） -->
<view wx:if="{{replyOpen}}" class="overlay" bindtap="onCloseReply">
  <view class="drawer" catchtap="noop"
        style="padding-bottom: calc({{keyboardHeight}}px + 28rpx + env(safe-area-inset-bottom));">
    <view class="handle"></view>
    <view class="drawer-date">📅 今天 · {{todayLongText}}</view>
    <!-- 输入内容不受 data 控制（不绑 value）：内容由文本域自己持有，逐键回写 data 会让
         每次按键都过一次渲染层；提交时由 JS 侧读输入事件存下的草稿 -->
    <view class="reply-editor">
      <textarea
        class="reply-input"
        placeholder="这一次用起来，感觉怎么样？"
        placeholder-class="reply-ph"
        maxlength="300"
        auto-focus
        adjust-position="{{false}}"
        bindinput="onReplyInput"
        bindkeyboardheightchange="onKeyboard"
        bindblur="onKeyboardBlur"
        cursor-spacing="20"
      />
    </view>
    <view class="btn-primary reply-save" hover-class="btn-primary-hover" bindtap="onSaveReply">✍️ 贴上这封回信</view>
    <view class="drawer-collapse" bindtap="onCloseReply">收 起</view>
  </view>
</view>

<!-- 保存成功反馈：便签样式轻 Toast（中上方浮现 2 秒，不挡操作） -->
<view wx:if="{{noteToast}}" class="note-toast">📌 回信已贴好。这封信越来越厚了。</view>
