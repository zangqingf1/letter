/* 03 · 信件详情 / 拆信阅读 / 回信 */
/* 信纸版式装饰与排版：共享样式（styles/paper.wxss，与写信预览/分享同构） */
@import "../../styles/paper.wxss";

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: var(--color-base-light);
}

/* ── 顶部轻导航：‹ 信匣 + 主题名称标签（靠左排列） ── */
.nav {
  flex: none;
  height: 88rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 0 32rpx;
}
.nav-back {
  font-size: 28rpx;
  color: var(--color-text-primary);
  padding: 8rpx 0;
}
.nav-back-hover {
  opacity: 0.6;
}

/* ── 可滚动主容器 ── */
.body {
  flex: 1 1 auto;
  min-height: 0;
}
.body-inner {
  padding-bottom: 8rpx;
}

/* ── 主信纸区：信纸自持版式（共享模板渲染，宽 630rpx 居中，高度随内容自适应）；
   装饰与排版全部在 styles/paper.wxss，此处只补阅读态间距 ── */
.body-inner .pl {
  padding-top: 8rpx;
}
/* 无障碍：关闭手写体开关时回信便签/输入框回落系统字体（信纸由共享样式处理） */
.hand-off .rb,
.hand-off .reply-input {
  font-family: var(--font-ui);
  letter-spacing: 0;
}

/* ── 桌面区块（戳痕成行：开放式桌面布局，邮戳墙 / 回信便签直接落在页面上） ── */
.sect {
  margin: 36rpx 32rpx 0;
}
/* 区头：mono 编号章 + 宋体标题 + 计数 + 虚线延长线（素笺正席编号语言） */
.ph-h {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 8rpx;
}
.ph-no {
  font-family: 'Courier New', Consolas, monospace;
  font-size: 20rpx;
  color: var(--color-accent-primary);
  border: 2rpx solid rgba(107, 142, 133, 0.55);
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  letter-spacing: 2rpx;
}
.ph-t {
  font-family: 'Noto Serif SC', 'Songti SC', serif;
  font-size: 27rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  color: var(--color-text-primary);
}
.ph-sub {
  font-family: 'Courier New', Consolas, monospace;
  font-size: 20rpx;
  color: #A29B8A;
  letter-spacing: 1rpx;
}
.ph-h::after {
  content: "";
  flex: 1;
  border-top: 1rpx dashed rgba(125, 133, 128, 0.4);
}

/* 邮戳墙（戳痕成行）：一条水平虚线邮路贯穿，双环邮戳沿路排列、微倾交替；
   展开态（多于一行）加 expanded 隐藏邮路线 */
.stampline {
  position: relative;
  padding: 12rpx 0 4rpx;
}
.stampline::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 58rpx; /* 邮戳垂直中心 = padding 12rpx + 半径 46rpx */
  border-top: 3rpx dashed rgba(139, 133, 120, 0.5);
}
.stampline.expanded::before {
  display: none;
}
.postmarks {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: flex-start;
}
.postmark {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  border: 3rpx dashed rgba(139, 133, 120, 0.75);
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8B8578;
  background: var(--color-base-light); /* 纸底色盖住邮路线，戳内不断线 */
  box-sizing: border-box;
}
/* 内圈细虚线，双环邮戳的盖印层次 */
.postmark::after {
  content: "";
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  right: 8rpx;
  bottom: 8rpx;
  border-radius: 50%;
  border: 2rpx dashed rgba(139, 133, 120, 0.45);
}
.postmark:nth-child(odd) {
  transform: rotate(-4deg);
}
.postmark:nth-child(even) {
  transform: rotate(3deg);
}
.pm-date {
  font-family: 'Courier New', Consolas, monospace;
  font-weight: 700;
  font-size: 24rpx;
}
.pm-label {
  font-size: 18rpx;
  margin-top: 2rpx;
  letter-spacing: 1rpx;
  opacity: 0.85;
}
/* 今日邮戳：实线 + 鼠尾草色 + 外圈光晕，与旧戳一眼区分 */
.postmark.today {
  color: var(--color-accent-primary);
  border-style: solid;
  border-color: #6B8E85;
  box-shadow: 0 0 0 6rpx rgba(107, 142, 133, 0.12);
}
.postmark.today::after {
  border-color: rgba(107, 142, 133, 0.5);
}
.postmark.today .pm-label {
  opacity: 1;
  font-weight: 700;
}
/* 「+N 展开/收起」：挂在邮路末端的虚线胶囊 */
.postmark.more {
  width: auto;
  height: auto;
  min-width: 84rpx;
  border: 3rpx dashed rgba(110, 117, 112, 0.55);
  border-radius: 24rpx;
  padding: 10rpx 22rpx;
  background: var(--color-base-light);
  box-shadow: none;
  margin-top: 6rpx;
  transform: none; /* 胶囊不参与邮戳的微倾交替 */
}
.postmark.more::after {
  display: none;
}
.postmark.more .pm-date {
  font-size: 28rpx;
  color: #6E7570;
}
.postmark.more .pm-label {
  color: #6E7570;
  opacity: 1;
}

/* ── 回信便签（戳痕成行：暖黄便签 + 顶部胶带 + mono 编目行 + 淡横线信纸纹） ── */
.reply-note {
  position: relative;
  background: #FFF6E2;
  border-radius: 8rpx;
  padding: 30rpx 26rpx 22rpx;
  margin-top: 26rpx;
  box-shadow: 0 12rpx 28rpx rgba(80, 90, 70, 0.15);
}
.reply-note.r1 {
  transform: rotate(-1deg);
}
.reply-note.r2 {
  transform: rotate(0.8deg);
}
/* 顶部胶带：半透明陶土胶带斜贴在便签上沿 */
.reply-note::before {
  content: "";
  position: absolute;
  top: -12rpx;
  left: 50%;
  width: 92rpx;
  height: 26rpx;
  transform: translateX(-50%) rotate(-2deg);
  background: rgba(197, 138, 106, 0.22);
  border-left: 2rpx dashed rgba(197, 138, 106, 0.35);
  border-right: 2rpx dashed rgba(197, 138, 106, 0.35);
}
.rd-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}
.rd-no {
  font-family: 'Courier New', Consolas, monospace;
  font-size: 18rpx;
  color: #B0A794;
  letter-spacing: 1rpx;
}
.rd-date {
  font-family: 'Courier New', Consolas, monospace;
  font-size: 21rpx;
  font-weight: 700;
  color: #8B8578;
}
/* 撕掉回信入口：mono 编目行右端的虚线下划线文字按钮 */
.reply-del {
  margin-left: auto;
  font-size: 20rpx;
  color: #8B8578;
  padding: 2rpx 4rpx 6rpx;
  letter-spacing: 2rpx;
  border-bottom: 2rpx dashed rgba(139, 133, 120, 0.6);
}
.reply-del-hover {
  opacity: 0.6;
}
.rb {
  margin-top: 14rpx;
  font-family: var(--font-hand);
  font-size: 28rpx;
  line-height: 52rpx;
  color: #4A4438;
  /* 淡横线信纸纹：与便签行距对齐 */
  background-image: repeating-linear-gradient(
    to bottom,
    transparent 0,
    transparent 51.6rpx,
    rgba(150, 140, 110, 0.16) 51.6rpx,
    rgba(150, 140, 110, 0.16) 52rpx
  );
  background-attachment: local;
}

/* 回信引导入口：陶土色虚线框触发块（戳痕成行语气，文案不变） */
.reply-cta {
  margin: 36rpx 32rpx 0;
  border: 3rpx dashed rgba(197, 138, 106, 0.65);
  border-radius: 24rpx;
  padding: 26rpx 28rpx;
  text-align: center;
  font-size: 24rpx;
  letter-spacing: 3rpx;
  color: #A0714F;
  background: rgba(197, 138, 106, 0.06);
}
.reply-cta-hover {
  background: rgba(197, 138, 106, 0.14);
}
.body-space {
  height: 24rpx;
}

/* ── 底部悬浮操作栏（毛玻璃独立底板）：编辑 / 回形针 / 分享 / 删除 ── */
.detail-ops {
  flex: none;
  margin: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(244, 243, 238, 0.92);
  backdrop-filter: blur(16rpx);
  border: 1rpx solid var(--line);
  border-radius: 32rpx;
  padding: 20rpx 12rpx;
  display: flex;
  justify-content: space-around;
}
.op {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: var(--color-text-primary);
}
.op-hover {
  opacity: 0.7;
}
.op .oi {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  border: 3rpx solid currentColor;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  box-sizing: border-box;
}
/* 回形针点亮态（优先展示 BR-06） */
.op.on {
  color: var(--color-accent-secondary);
  font-weight: 700;
}
.op.on .oi {
  background: var(--color-accent-secondary);
  color: #FFFFFF;
  border-color: var(--color-accent-secondary);
  box-shadow: 0 4rpx 16rpx rgba(196, 164, 130, 0.35);
}

/* ── 拆信动画（约 1.2s，可点击跳过；纸张物理感：仅位移/淡入淡出，无弹跳闪光） ── */
.unseal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #EDE9DC;
  animation: unseal-fade 1.3s ease forwards;
}
@keyframes unseal-fade {
  0%,
  86% {
    opacity: 1;
  }
  100% {
    opacity: 0;
  }
}
.us-stage {
  position: relative;
  width: 560rpx;
  height: 500rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
/* 信纸：从信封后抽出并展开（z 层在信封之下，向上位移即"抽出"）；配色纸张 + 横线，无图片素材 */
.us-paper {
  position: absolute;
  width: 400rpx;
  height: 520rpx;
  z-index: 1;
  border-radius: 8rpx;
  padding: 36rpx 40rpx;
  box-sizing: border-box;
  box-shadow: 0 6rpx 20rpx rgba(80, 100, 90, 0.12);
  animation: paper-out 1.25s ease forwards;
}
.us-paper-headline {
  border-top: 5rpx solid #C58A6A;
  margin-bottom: 28rpx;
}
.us-paper-line {
  height: 56rpx;
  border-bottom: 1rpx solid rgba(150, 140, 110, 0.3);
}
@keyframes paper-out {
  0% {
    opacity: 0;
    transform: translateY(140rpx) scale(0.82);
  }
  15% {
    opacity: 1;
  }
  55% {
    transform: translateY(-160rpx) scale(0.88);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1.1);
  }
}
/* 信封：微浮起（阴影加深）→ 淡出移出屏幕 */
.us-env {
  position: absolute;
  width: 560rpx;
  z-index: 2;
  animation: env-out 1.25s ease forwards;
}
.us-env-img {
  display: block;
  width: 100%;
  border-radius: 14rpx;
  box-shadow: 0 10rpx 32rpx rgba(80, 100, 90, 0.2);
}
@keyframes env-out {
  0% {
    opacity: 0;
    transform: translateY(16rpx);
    box-shadow: none;
  }
  10% {
    opacity: 1;
  }
  22% {
    transform: translateY(-14rpx);
  }
  55% {
    opacity: 1;
    transform: translateY(0) rotate(0deg);
  }
  85% {
    opacity: 0;
    transform: translateY(90rpx) rotate(-5deg);
  }
  100% {
    opacity: 0;
  }
}
.us-env-name {
  position: absolute;
  left: 0;
  right: 0;
  top: 100%;
  margin-top: 20rpx;
  text-align: center;
  font-family: var(--font-heading);
  font-size: 30rpx;
  font-weight: 700;
  color: #6B5C48;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
/* 今日重读邮戳：随浮起盖到信封右上角 */
.us-stamp {
  position: absolute;
  top: 5%;
  right: 5%;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(107, 142, 133, 0.85);
  transform: rotate(8deg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: rgba(107, 142, 133, 0.9);
  background: rgba(244, 243, 238, 0.35);
  animation: stamp-in 0.45s ease 0.35s both;
}
@keyframes stamp-in {
  from {
    opacity: 0;
    transform: rotate(8deg) scale(1.3);
  }
  to {
    opacity: 1;
    transform: rotate(8deg) scale(1);
  }
}
.us-stamp-date {
  font-weight: 800;
  font-size: 26rpx;
}
.us-stamp-label {
  font-size: 18rpx;
}
.us-hint {
  position: absolute;
  left: 0;
  right: 0;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  opacity: 0.85;
}

/* ── 回信弹层：40% 暖灰遮罩 + 半屏便签抽屉 ── */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  background: rgba(46, 51, 48, 0.4);
  backdrop-filter: blur(8rpx);
  display: flex;
  align-items: flex-end;
  animation: overlay-in 0.3s ease;
}
@keyframes overlay-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
.drawer {
  width: 100%;
  background: var(--color-base-light);
  border-radius: 48rpx 48rpx 0 0;
  padding: 24rpx 40rpx 0;
  transform: rotate(-0.6deg);
  animation: drawer-up 0.35s ease-out;
}
@keyframes drawer-up {
  from {
    transform: translateY(100%) rotate(-0.6deg);
  }
  to {
    transform: translateY(0) rotate(-0.6deg);
  }
}
.handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--color-disabled);
  margin: 0 auto 24rpx;
}
/* 日期固定不可修改：纯展示，无任何选择器控件 */
.drawer-date {
  text-align: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 20rpx;
}
.reply-editor {
  background: #FFF6E2;
  border: 1rpx solid #EADFC5;
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
}
.reply-input {
  width: 100%;
  min-height: 232rpx;
  box-sizing: border-box;
  font-family: var(--font-hand);
  font-size: 32rpx;
  line-height: 57.6rpx;
  letter-spacing: 1rpx;
  color: #5C4D3A;
  background-image: repeating-linear-gradient(
    to bottom,
    transparent 0,
    transparent 57.4rpx,
    rgba(150, 140, 110, 0.24) 57.4rpx,
    rgba(150, 140, 110, 0.24) 57.6rpx
  );
  background-attachment: local;
}
.reply-ph {
  color: rgba(125, 133, 128, 0.55);
  font-family: var(--font-hand);
}
.reply-save {
  margin-top: 28rpx;
}
.drawer-collapse {
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  padding-top: 20rpx;
}

/* ── 便签样式轻 Toast：中上方浮现 2 秒，无遮罩不挡操作 ── */
.note-toast {
  position: fixed;
  top: 24%;
  left: 50%;
  transform: translateX(-50%) rotate(-1.5deg);
  z-index: 120;
  max-width: 80%;
  background: #FFF6E2;
  border: 1rpx solid #EADFC5;
  border-radius: 16rpx;
  padding: 20rpx 32rpx;
  font-size: 26rpx;
  color: #5C4D3A;
  box-shadow: var(--shadow-warm-sm);
  animation: toast-in 0.3s ease;
}
@keyframes toast-in {
  from {
    opacity: 0;
    transform: translateX(-50%) rotate(-1.5deg) translateY(-12rpx);
  }
  to {
    opacity: 1;
    transform: translateX(-50%) rotate(-1.5deg) translateY(0);
  }
}
