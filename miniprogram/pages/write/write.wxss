/* 02 · 写信第一步「写下这封信」 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: var(--color-base-light);
}

/* ── 顶部轻导航（7% 屏高）：返回 + 步骤条 ── */
.nav {
  position: relative;
  flex: none;
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}
.nav-back {
  font-size: 28rpx;
  color: var(--color-text-primary);
  padding: 8rpx 0;
}
.nav-back-hover {
  opacity: 0.6;
}
/* 步骤条绝对居中，宋体极轻量 */
.steps {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-family: var(--font-heading);
  font-size: 24rpx;
}
.steps .step {
  color: var(--color-text-secondary);
}
.steps .step.on {
  color: var(--color-text-primary);
  font-weight: 700;
  position: relative;
}
.steps .step.on::after {
  content: "";
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: -12rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-accent-primary);
}
.steps .step-sep {
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

/* ── 信纸容器（滚动主体） ── */
.paper-scroll {
  flex: 1;
  min-height: 0;
}
.paper {
  margin: 16rpx 32rpx 40rpx;
  background: #FBF6EA;
  border-radius: 20rpx;
  padding: 36rpx 36rpx 44rpx;
  box-shadow: var(--shadow-warm-sm);
}

/* 信纸头线（陶土色）+ 信件名称 + 日期行 + 角落虚线小邮戳（素笺正席信头） */
.headline {
  border-top: 8rpx solid #C58A6A;
  margin: 0 auto 28rpx;
  padding-top: 28rpx;
  text-align: center;
  position: relative;
}
.head-stamp {
  position: absolute;
  top: 8rpx;
  right: 0;
  width: 112rpx;
  height: 112rpx;
  border: 3rpx dashed rgba(197, 138, 106, 0.75);
  border-radius: 50%;
  transform: rotate(10deg);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #C58A6A;
  mix-blend-mode: multiply;
  pointer-events: none; /* 不挡标题输入的点击 */
  opacity: 0.85;
}
.head-stamp::before {
  content: "";
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  bottom: 10rpx;
  left: 10rpx;
  border: 2rpx dashed rgba(197, 138, 106, 0.5);
  border-radius: 50%;
}
.stamp-name {
  font-family: var(--font-heading);
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  text-indent: 4rpx;
}
.stamp-date {
  font-family: 'Courier New', Consolas, monospace;
  font-size: 16rpx;
  letter-spacing: 1rpx;
  opacity: 0.8;
}
.title-input {
  font-family: var(--font-heading);
  font-size: 38rpx;
  font-weight: 700;
  text-align: center;
  color: var(--color-text-primary);
  height: 56rpx;
  line-height: 56rpx;
}
.title-ph {
  color: #B4AA96;
  font-weight: 400;
  font-size: 32rpx;
}
.head-date {
  margin-top: 10rpx;
  font-size: 20rpx;
  letter-spacing: 6rpx;
  color: #A29B8A;
}
.head-date::before,
.head-date::after {
  content: "—";
  margin: 0 14rpx;
  color: #D8CFBB;
}

/* 编号印制引导语（其一/其二 鼠尾草编号 + 两侧短横线） */
.field-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  letter-spacing: 4rpx;
  margin: 24rpx 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
.field-label::before,
.field-label::after {
  content: "";
  height: 1rpx;
  background: var(--line);
  flex: 0 0 48rpx;
}
.label-no {
  color: var(--color-accent-primary);
  font-family: var(--font-heading);
}

/* 手写体输入区（32rpx / 行高 1.8 = 57.6rpx，与信纸横线 28.8px 对齐） */
.hand-input {
  width: 100%;
  box-sizing: border-box;
  font-family: var(--font-hand);
  font-size: 32rpx;
  line-height: 57.6rpx;
  letter-spacing: 1rpx;
  color: #4A4438;
  padding: 0;
  min-height: 174rpx; /* 问题区至少 3 行 */
  /* 信纸横线：每行 57.6rpx 一条浅陶土色细线 */
  background-image: repeating-linear-gradient(
    to bottom,
    transparent 0,
    transparent 57.4rpx,
    rgba(150, 140, 110, 0.24) 57.4rpx,
    rgba(150, 140, 110, 0.24) 57.6rpx
  );
  background-attachment: local;
}
.hand-answer {
  min-height: 232rpx; /* 答案区至少 4 行 */
}
/* 无障碍：关闭手写体开关生效时回落到系统字体 */
.hand-off {
  font-family: var(--font-ui);
  letter-spacing: 0;
}

/* 字数计数：各输入区右下角轻淡 mono 编目式显示 */
.count {
  font-family: 'Courier New', Consolas, monospace;
  font-size: 20rpx;
  color: #B4AFA2;
  text-align: right;
  margin-top: 12rpx;
}

/* 物理折痕分隔线（虚线 + 微弱形变） */
/* 行容器左右外扩到信纸边缘，使三角形缺口贴住纸边 */
.fold-row {
  position: relative;
  margin: 36rpx -36rpx;
}
/* 页面底色小三角形叠在纸边，底边贴纸边、尖端向内，形成缺失的撕纸缺口 */
.notch {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 0;
  height: 0;
  border-style: solid;
}
.notch-l {
  left: 0;
  border-width: 20rpx 0 20rpx 26rpx;
  border-color: transparent transparent transparent var(--color-base-light);
}
.notch-r {
  right: 0;
  border-width: 20rpx 26rpx 20rpx 0;
  border-color: transparent var(--color-base-light) transparent transparent;
}
.fold {
  height: 4rpx;
  background: repeating-linear-gradient(
    90deg,
    var(--color-text-secondary) 0 16rpx,
    transparent 16rpx 32rpx
  );
  opacity: 0.3;
  margin: 0 36rpx;
  border-radius: 4rpx;
}

/* ── 底部固定操作栏（毛玻璃底板） ── */
.btn-bar {
  flex: none;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(244, 243, 238, 0.9);
  backdrop-filter: blur(16rpx);
  border-top: 1rpx solid var(--line);
}
.btn-sec {
  height: 80rpx;
  padding: 0 32rpx;
  border-radius: 24rpx;
  background: var(--color-base-surface);
  border: 1rpx solid var(--color-disabled);
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--color-text-primary);
}
.btn-sec-hover {
  opacity: 0.7;
}
.btn-next {
  flex: 1;
}
/* 状态一：名称/问题/答案未填完整时主按钮置灰不可点 */
.btn-next-disabled {
  background: #B7C2BE;
  color: rgba(244, 243, 238, 0.9);
  box-shadow: 0 8rpx 20rpx rgba(183, 194, 190, 0.3);
}

/* ── 草稿便签夹：鼠尾草虚线托盘 + 回形针白卡（素笺正席版式） ── */
.draft-shelf {
  margin: 20rpx 32rpx 40rpx;
  padding: 24rpx 24rpx 20rpx;
  border: 2rpx dashed #A9BDB6;
  border-radius: 20rpx;
  background: rgba(107, 142, 133, 0.07);
}
.draft-shelf-title {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 24rpx;
  letter-spacing: 6rpx;
  color: var(--color-accent-primary);
  margin-bottom: 16rpx;
}
.draft-shelf-title::after {
  content: "";
  flex: 1;
  border-top: 2rpx dashed rgba(107, 142, 133, 0.4);
}
.draft-shelf-num {
  font-family: 'Courier New', Consolas, monospace;
  font-size: 20rpx;
  letter-spacing: 0;
  line-height: 32rpx;
  padding: 0 14rpx;
  border: 2rpx solid rgba(107, 142, 133, 0.5);
  border-radius: 16rpx;
}
.draft-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  box-shadow: var(--shadow-warm-sm);
}
.draft-card:last-of-type {
  margin-bottom: 0;
}
.draft-card-hover {
  opacity: 0.75;
}
/* CSS 回形针角标（金色，与回形针页 clip.png 同意象） */
.draft-card-clip {
  flex: none;
  width: 22rpx;
  height: 42rpx;
  border: 3rpx solid #C4A482;
  border-radius: 12rpx;
  position: relative;
  transform: rotate(-8deg);
}
.draft-card-clip::before {
  content: "";
  position: absolute;
  top: 5rpx;
  left: 5rpx;
  right: 5rpx;
  height: 18rpx;
  border: 3rpx solid #C4A482;
  border-bottom: none;
  border-radius: 10rpx 10rpx 0 0;
}
.draft-card-main {
  flex: 1;
  min-width: 0;
}
.draft-card-name {
  font-family: 'Noto Serif SC', 'Songti SC', serif;
  font-size: 28rpx;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.draft-card-snip {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.draft-card-side {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}
.draft-card-time {
  font-family: 'Courier New', Consolas, monospace;
  font-size: 20rpx;
  color: #B4AFA2;
}
.draft-card-del {
  font-size: 22rpx;
  color: #6E7570;
  padding: 4rpx 4rpx 6rpx;
  border-bottom: 2rpx dashed rgba(110, 117, 112, 0.5);
}
.draft-card-del-hover {
  opacity: 0.6;
}
.draft-shelf-note {
  font-size: 20rpx;
  color: #9AA5A0;
  letter-spacing: 2rpx;
  margin-top: 18rpx;
  text-align: center;
}
