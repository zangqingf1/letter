/* 02 · 写信第二步「选信纸并寄出」 */
/* 信纸版式装饰与排版：共享样式（styles/paper.wxss，与详情/分享同构） */
@import "../../styles/paper.wxss";

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: var(--color-base-light);
}

/* ── 顶部轻导航 ── */
.nav {
  position: relative;
  flex: none;
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}
.nav-back {
  font-size: 28rpx;
  color: var(--color-text-primary);
  padding: 8rpx 0;
}
.nav-back-hover {
  opacity: 0.6;
}
.steps {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-family: var(--font-heading);
  font-size: 24rpx;
}
.steps .step {
  color: var(--color-text-secondary);
}
.steps .step.on {
  color: var(--color-text-primary);
  font-weight: 700;
  position: relative;
}
.steps .step.on::after {
  content: "";
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: -12rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-accent-primary);
}
.steps .step-sep {
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

/* ── 实时预览区（占满主题区与寄出栏以外的全部空间，暖桌面） ── */
.preview {
  position: relative;
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

/* 信纸视图容器：配色信纸居中展开（高度随内容自适应，长文在纸内滚动） */
.pl {
  display: flex;
  flex-direction: column;
  align-items: center;
  max-height: 100%;
  width: 100%;
}
/* 切换主题的"翻页"微动效（纸张物理感：淡入 + 轻位移，无弹跳闪光） */
.pl-flip {
  animation: page-flip 240ms ease;
}
@keyframes page-flip {
  from {
    opacity: 0.25;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
/* 预览态信纸限高：长文纸内滚动（阅读/分享端不限高，随内容生长） */
.preview .pl-paper {
  max-height: 100%;
}

/* ── 预览区横滑（信纸版式选择）：swiper 占满预览区，纸居中 ── */
.preview-swiper {
  width: 100%;
  height: 100%;
}
.pv-item {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}
/* 会员专属信纸锁定角标（预览纸右上角，与主题卡 tc-lock 同款） */
.pv-lock {
  position: absolute;
  top: 8rpx;
  right: 20rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 26rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(80, 90, 85, 0.14);
  z-index: 2;
}
/* 版式指示：当前版式名 + 圆点（点击直切） */
.paper-ind {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 12rpx 0 4rpx;
}
.paper-ind-name {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}
.paper-ind-cur {
  color: var(--color-accent-primary);
  font-weight: 700;
}
.paper-dots {
  display: flex;
  gap: 12rpx;
}
.paper-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-disabled);
  transition: background 0.2s ease;
}
.paper-dot.on {
  background: var(--color-accent-primary);
}

/* ── 主题选择与交互区（压缩到刚好放下卡片流，剩余空间让给预览） ── */
.theme-area {
  flex: none;
  padding-top: 12rpx;
}
.theme-label {
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  padding-bottom: 12rpx;
}
.theme-name {
  color: var(--color-accent-primary);
  font-weight: 700;
}
.theme-row {
  white-space: nowrap;
}
.theme-card {
  position: relative;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 152rpx;
  margin: 0 12rpx;
  padding: 10rpx 10rpx 12rpx;
  border-radius: 20rpx;
  background: var(--color-base-surface);
  border: 3rpx solid transparent;
  box-sizing: border-box;
  vertical-align: top;
}
.theme-card.sel {
  border-color: var(--color-accent-primary);
  background: #FFFFFF;
}
.tc-img {
  width: 128rpx;
  height: 84rpx;
  border-radius: 10rpx;
}
/* 无自有信封素材的主题（会员专属款）用色样展示，信封统一回落默认款 */
.tc-swatch {
  width: 128rpx;
  height: 84rpx;
  border-radius: 10rpx;
  box-shadow: inset 0 0 0 1rpx rgba(80, 100, 90, 0.08);
}
.tc-name {
  margin-top: 10rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}
.theme-card.sel .tc-name {
  color: var(--color-accent-primary);
}
/* 会员专属主题锁定角标 */
.tc-lock {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 50%;
}

/* ── 底部火漆寄出栏 ── */
.wax-wrap {
  flex: none;
  margin-top: 8rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(244, 243, 238, 0.9);
  backdrop-filter: blur(16rpx);
  border-top: 1rpx solid var(--line);
}
.wax-cta {
  gap: 16rpx;
}
/* 寄出完成动效：火漆盖下（缩小按压，无弹跳） */
.wax-sealing {
  transform: scale(0.94);
  box-shadow: 0 4rpx 12rpx rgba(107, 142, 133, 0.2);
}
.wax-amp {
  width: 36rpx;
  height: 36rpx;
  background: #5E8378;
  border-radius: 50%;
  box-shadow: inset 0 0 0 6rpx rgba(244, 243, 238, 0.5);
  flex: none;
}

/* ── 寄出动效：火漆按压时预览信纸轻沉折起（位移 + 微缩，无弹跳） ── */
.preview .pl {
  transition: transform 400ms ease, opacity 400ms ease;
}
.preview-sealing .pl {
  transform: translateY(8rpx) scale(0.985);
  opacity: 0.85;
}

/* ── 寄出完成幕：暖纸底全屏浮层，信封落定 → 火漆印 → 文案依次淡入 ── */
.send-fx {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 99;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(244, 243, 238, 0.96);
  animation: fx-in 220ms ease;
}
@keyframes fx-in {
  from { opacity: 0; }
}
/* 幕布淡出后跳转信匣 */
.send-fx.fx-out {
  animation: fx-out 220ms ease forwards;
}
@keyframes fx-out {
  to { opacity: 0; }
}
.fx-env {
  position: relative;
  width: 420rpx;
  border-radius: 16rpx;
  box-shadow: var(--shadow-warm-sm);
  /* 信封从上方 10px 落定（位移方向模拟投进信匣） */
  animation: fx-env-in 380ms ease-out;
}
@keyframes fx-env-in {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
}
.fx-env-img {
  display: block;
  width: 100%;
  height: 280rpx;
  border-radius: 16rpx;
}
.fx-copy {
  margin-top: 40rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  animation: fx-copy-in 260ms ease 520ms backwards;
}
@keyframes fx-copy-in {
  from {
    opacity: 0;
    transform: translateY(5px);
  }
}
