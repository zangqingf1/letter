/* 02 · 写信第二步「选信纸并寄出」 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: var(--color-base-light);
}

/* ── 顶部轻导航 ── */
.nav {
  position: relative;
  flex: none;
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}
.nav-back {
  font-size: 28rpx;
  color: var(--color-text-primary);
  padding: 8rpx 0;
}
.nav-back-hover {
  opacity: 0.6;
}
.steps {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-family: var(--font-heading);
  font-size: 24rpx;
}
.steps .step {
  color: var(--color-text-secondary);
}
.steps .step.on {
  color: var(--color-text-primary);
  font-weight: 700;
  position: relative;
}
.steps .step.on::after {
  content: "";
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: -12rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-accent-primary);
}
.steps .step-sep {
  color: var(--color-text-secondary);
  font-size: 22rpx;
}

/* ── 实时预览区（占满主题区与寄出栏以外的全部空间，暖桌面） ── */
.preview {
  position: relative;
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

/* 信纸视图：配色信纸居中展开（高度随内容自适应，长文在纸内滚动） */
.lv {
  display: flex;
  flex-direction: column;
  align-items: center;
  max-height: 100%;
}
/* 切换主题的"翻页"微动效（纸张物理感：淡入 + 轻位移，无弹跳闪光） */
.lv-flip {
  animation: page-flip 240ms ease;
}
@keyframes page-flip {
  from {
    opacity: 0.25;
    transform: translateY(10rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.lv-paper {
  width: 590rpx;
  max-height: 100%;
  overflow-y: auto;
  box-sizing: border-box;
  border-radius: 12rpx;
  padding: 40rpx 64rpx 48rpx;
  filter: drop-shadow(0 8rpx 20rpx rgba(80, 100, 90, 0.18));
}
/* 信纸头线（陶土色，与写信第一步 headline 同源） */
.lv-headline {
  border-top: 6rpx solid #C58A6A;
  margin-bottom: 24rpx;
}
.lv-name {
  font-family: var(--font-heading);
  font-size: 30rpx;
  font-weight: 700;
  text-align: center;
  color: #5A4F3E;
  margin-bottom: 12rpx;
}
.lv-tag {
  font-family: var(--font-ui);
  font-size: 20rpx;
  color: #9A9284;
  letter-spacing: 2rpx;
  margin-top: 20rpx;
}
.lv-body {
  font-family: var(--font-hand);
  font-size: 26rpx;
  line-height: 1.8;
  letter-spacing: 0.5rpx;
  color: #4A4438;
  white-space: pre-wrap;
}
.lv-date {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  text-align: right;
  margin-top: 36rpx;
}

/* ── 预览区横滑（信纸版式选择）：swiper 占满预览区，纸居中 ── */
.preview-swiper {
  width: 100%;
  height: 100%;
}
.pv-item {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
/* 版式指示：当前版式名 + 圆点（点击直切） */
.paper-ind {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 12rpx 0 4rpx;
}
.paper-ind-name {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}
.paper-ind-cur {
  color: var(--color-accent-primary);
  font-weight: 700;
}
.paper-dots {
  display: flex;
  gap: 12rpx;
}
.paper-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-disabled);
  transition: background 0.2s ease;
}
.paper-dot.on {
  background: var(--color-accent-primary);
}

/* ── 信纸版式装饰（papers.js）──
   通用性约定：装饰色仅固定暖色锚点（陶土 #C58A6A）+ 暖灰派生透明度，
   不依赖主题配色，任意主题底色下成立；无纯黑、无冷灰阴影 */
/* 航空笺：斜纹边框包裹整纸，内容在内层底色卡 */
.paper-airmail {
  padding: 10rpx;
  background: repeating-linear-gradient(
    -45deg,
    rgba(197, 138, 106, 0.38) 0 14rpx,
    transparent 14rpx 26rpx,
    rgba(125, 133, 128, 0.3) 26rpx 40rpx,
    transparent 40rpx 52rpx
  );
}
.pv-air-inner {
  border-radius: 8rpx;
  padding: 28rpx 36rpx 40rpx;
  box-sizing: border-box;
  max-height: 100%;
  overflow-y: auto;
}
.pv-air-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.pv-air-label {
  font-family: var(--font-ui);
  font-size: 18rpx;
  color: #9A9284;
  letter-spacing: 4rpx;
  line-height: 1.7;
  text-align: center;
  border: 2rpx solid rgba(125, 133, 128, 0.45);
  border-radius: 6rpx;
  padding: 8rpx 16rpx;
}
.pv-air-label text {
  display: block;
}
.pv-air-en {
  font-size: 14rpx;
  letter-spacing: 2rpx;
}
.pv-air-stamp {
  position: relative;
  flex: none;
  width: 110rpx;
  height: 126rpx;
  border: 2rpx dashed rgba(125, 133, 128, 0.55);
  border-radius: 4rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}
.pv-stamp-mini {
  width: 44rpx;
  height: 56rpx;
  background: rgba(197, 138, 106, 0.28);
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-heading);
  font-size: 24rpx;
  font-weight: 700;
}
.pv-stamp-name {
  font-size: 16rpx;
  letter-spacing: 2rpx;
}
.pv-postmark {
  position: absolute;
  right: -34rpx;
  top: 30rpx;
  width: 92rpx;
  height: 92rpx;
  border: 3rpx solid rgba(125, 133, 128, 0.75);
  border-radius: 50%;
  transform: rotate(-12deg);
  opacity: 0.85;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pv-postmark::after {
  content: "";
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 8rpx;
  bottom: 8rpx;
  border: 2rpx solid rgba(125, 133, 128, 0.5);
  border-radius: 50%;
}
.pv-pm-date {
  font-family: var(--font-heading);
  font-size: 20rpx;
  font-weight: 700;
  color: #7D8580;
  letter-spacing: 2rpx;
}
/* 航空笺「问 / 答」引导词 */
.paper-airmail .lv-q::before,
.paper-airmail .lv-a::before {
  font-family: var(--font-ui);
  font-size: 18rpx;
  color: #9A9284;
  letter-spacing: 2rpx;
}
.paper-airmail .lv-q::before {
  content: "问 / ";
}
.paper-airmail .lv-a::before {
  content: "答 / ";
}

/* 笔记本：踩线横格（26rpx·1.8 = 46.8rpx 行盒，格线落在基线下方）+ 陶土边线 + 装订孔 */
.paper-notebook {
  position: relative;
  padding: 40rpx 48rpx 44rpx 88rpx;
}
.pv-marginline {
  position: absolute;
  left: 62rpx;
  top: 0;
  bottom: 0;
  width: 3rpx;
  background: rgba(197, 138, 106, 0.55);
}
.pv-holes {
  position: absolute;
  left: 18rpx;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
}
.pv-holes view {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: rgba(80, 100, 90, 0.1);
  box-shadow: inset 0 2rpx 4rpx rgba(80, 100, 90, 0.28);
}
.paper-notebook .lv-body {
  background-image: repeating-linear-gradient(
    to bottom,
    transparent 0 40rpx,
    rgba(125, 133, 128, 0.26) 40rpx 42rpx,
    transparent 42rpx 46.8rpx
  );
}
.paper-notebook .lv-name {
  display: inline-block;
  text-align: left;
  border-bottom: 1rpx solid rgba(125, 133, 128, 0.4);
  padding-bottom: 10rpx;
}

/* 织纹笺：十字织纹底 + 双线内框 + 四角陶土饰 + 问/答标签 */
.paper-weave {
  position: relative;
  padding: 30rpx 32rpx 34rpx;
  background-image:
    repeating-linear-gradient(0deg, rgba(46, 51, 48, 0.03) 0 1rpx, transparent 1rpx 8rpx),
    repeating-linear-gradient(90deg, rgba(46, 51, 48, 0.03) 0 1rpx, transparent 1rpx 8rpx);
}
.pv-weave-frame {
  position: relative;
  border: 1rpx solid rgba(125, 133, 128, 0.38);
  padding: 26rpx 30rpx 30rpx;
}
.pv-weave-frame::after {
  content: "";
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 8rpx;
  bottom: 8rpx;
  border: 1rpx solid rgba(125, 133, 128, 0.18);
  pointer-events: none;
}
.pv-corner {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  z-index: 1;
}
.pv-corner::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  border: 3rpx solid #C58A6A;
  border-radius: 2rpx;
  transform: rotate(45deg);
  background: transparent;
}
.pv-corner.c-tl { top: 23rpx; left: 25rpx; }
.pv-corner.c-tr { top: 23rpx; right: 25rpx; }
.pv-corner.c-bl { bottom: 27rpx; left: 25rpx; }
.pv-corner.c-br { bottom: 27rpx; right: 25rpx; }
.paper-weave .lv-body::before {
  font-family: var(--font-ui);
  font-size: 18rpx;
  color: #9A9284;
  border: 1rpx solid rgba(125, 133, 128, 0.5);
  border-radius: 4rpx;
  padding: 2rpx 10rpx;
  margin-right: 12rpx;
  letter-spacing: 2rpx;
}
.paper-weave .lv-q::before {
  content: "问";
}
.paper-weave .lv-a::before {
  content: "答";
}

/* ── 主题选择与交互区（压缩到刚好放下卡片流，剩余空间让给预览） ── */
.theme-area {
  flex: none;
  padding-top: 12rpx;
}
.theme-label {
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  padding-bottom: 12rpx;
}
.theme-name {
  color: var(--color-accent-primary);
  font-weight: 700;
}
.theme-row {
  white-space: nowrap;
}
.theme-card {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 152rpx;
  margin: 0 12rpx;
  padding: 10rpx 10rpx 12rpx;
  border-radius: 20rpx;
  background: var(--color-base-surface);
  border: 3rpx solid transparent;
  box-sizing: border-box;
  vertical-align: top;
}
.theme-card.sel {
  border-color: var(--color-accent-primary);
  background: #FFFFFF;
}
.tc-img {
  width: 128rpx;
  height: 84rpx;
  border-radius: 10rpx;
}
/* 素材未就绪主题的色样占位（对应低保真 tc d1-d6 色块） */
.tc-swatch {
  width: 128rpx;
  height: 84rpx;
  border-radius: 10rpx;
  box-shadow: inset 0 0 0 1rpx rgba(80, 100, 90, 0.08);
}
.theme-card.pending {
  opacity: 0.72;
}
.tc-name {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}
.theme-card.sel .tc-name {
  color: var(--color-accent-primary);
}
.tc-desc {
  margin-top: 2rpx;
  font-size: 18rpx;
  color: var(--color-text-secondary);
}

/* ── 底部火漆寄出栏 ── */
.wax-wrap {
  flex: none;
  margin-top: 8rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(244, 243, 238, 0.9);
  backdrop-filter: blur(16rpx);
  border-top: 1rpx solid var(--line);
}
.wax-cta {
  gap: 16rpx;
}
/* 寄出完成动效：火漆盖下（缩小按压，无弹跳） */
.wax-sealing {
  transform: scale(0.94);
  box-shadow: 0 4rpx 12rpx rgba(107, 142, 133, 0.2);
}
.wax-amp {
  width: 36rpx;
  height: 36rpx;
  background: #5E8378;
  border-radius: 50%;
  box-shadow: inset 0 0 0 6rpx rgba(244, 243, 238, 0.5);
  flex: none;
}

/* ── 寄出动效：火漆按压时预览信纸轻沉折起（位移 + 微缩，无弹跳） ── */
.preview .lv {
  transition: transform 400ms ease, opacity 400ms ease;
}
.preview-sealing .lv {
  transform: translateY(8rpx) scale(0.985);
  opacity: 0.85;
}

/* ── 寄出完成幕：暖纸底全屏浮层，信封落定 → 火漆印 → 文案依次淡入 ── */
.send-fx {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 99;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(244, 243, 238, 0.96);
  animation: fx-in 220ms ease;
}
@keyframes fx-in {
  from { opacity: 0; }
}
/* 幕布淡出后跳转信匣 */
.send-fx.fx-out {
  animation: fx-out 220ms ease forwards;
}
@keyframes fx-out {
  to { opacity: 0; }
}
.fx-env {
  position: relative;
  width: 420rpx;
  border-radius: 16rpx;
  box-shadow: var(--shadow-warm-sm);
  /* 信封从上方 10px 落定（位移方向模拟投进信匣） */
  animation: fx-env-in 380ms ease-out;
}
@keyframes fx-env-in {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
}
.fx-env-img {
  display: block;
  width: 100%;
  height: 280rpx;
  border-radius: 16rpx;
}
.fx-copy {
  margin-top: 40rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  animation: fx-copy-in 260ms ease 520ms backwards;
}
@keyframes fx-copy-in {
  from {
    opacity: 0;
    transform: translateY(5px);
  }
}
