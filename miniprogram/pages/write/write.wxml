<!-- 02 · 写信第一步「写下这封信」（状态一：空白初始态 Placeholder / 状态二：填写中态手写体渲染） -->
<view class="page" style="padding-top: {{statusBarHeight}}px;">

  <!-- 顶部轻导航：返回 + 极轻量宋体步骤条 -->
  <view class="nav">
    <view class="nav-back" hover-class="nav-back-hover" bindtap="onTapBack">‹ 返回</view>
    <view class="steps">
      <text class="step on">写内容</text>
      <text class="step-sep">·</text>
      <text class="step">选主题</text>
    </view>
  </view>

  <!-- 信纸容器：整页一张可滚动信纸 -->
  <scroll-view class="paper-scroll" scroll-y>
    <view class="paper">

      <!-- 信纸头线 + 信件名称 + 日期行 + 角落虚线小邮戳（素笺正席信头） -->
      <view class="headline">
        <view class="head-stamp" aria-hidden="true">
          <text class="stamp-name">心灵信箱</text>
          <text class="stamp-date">{{headDateStamp}}</text>
        </view>
        <input
          class="title-input"
          placeholder="给这封信起个名字…"
          placeholder-class="title-ph"
          maxlength="{{NAME_MAX}}"
          value="{{name}}"
          bindinput="onNameInput"
        />
        <view class="head-date">写于 {{headDateCn}}</view>
      </view>

      <!-- 当时的问题：编号引导语 + 信纸横线手写区 -->
      <view class="field-label"><text class="label-no">其一</text><text>遇到了什么问题？</text></view>
      <textarea
        class="hand-input hand-question {{handwritingOff ? 'hand-off' : ''}}"
        value="{{question}}"
        maxlength="{{QUESTION_MAX}}"
        auto-height
        show-confirm-bar="{{false}}"
        bindinput="onQuestionInput"
      ></textarea>
      <view class="count">{{questionLen}} / {{QUESTION_MAX}}</view>

      <!-- 物理折痕分隔线（两端纸边处向内缺失小三角形缺口） -->
      <view class="fold-row">
        <view class="fold"></view>
        <view class="notch notch-l"></view>
        <view class="notch notch-r"></view>
      </view>

      <!-- 想明白的答案：纵深更长的手写区 -->
      <view class="field-label"><text class="label-no">其二</text><text>你可以怎么做？</text></view>
      <textarea
        class="hand-input hand-answer {{handwritingOff ? 'hand-off' : ''}}"
        value="{{answer}}"
        maxlength="{{ANSWER_MAX}}"
        auto-height
        show-confirm-bar="{{false}}"
        bindinput="onAnswerInput"
      ></textarea>
      <view class="count">{{answerLen}} / {{ANSWER_MAX}}</view>

    </view>

    <!-- 草稿便签夹：没写完的信（鼠尾草虚线托盘 + 回形针白卡；点击载入续写，撕毁为彻底删除不进废纸篓） -->
    <view wx:if="{{drafts.length}}" class="draft-shelf">
      <view class="draft-shelf-title">
        <text>没写完的信</text>
        <text class="draft-shelf-num">{{drafts.length}}</text>
      </view>
      <view
        wx:for="{{drafts}}"
        wx:key="id"
        class="draft-card"
        hover-class="draft-card-hover"
        data-id="{{item.id}}"
        bindtap="onTapDraftItem"
      >
        <view class="draft-card-clip" aria-hidden="true"></view>
        <view class="draft-card-main">
          <view class="draft-card-name">{{item.name}}</view>
          <view class="draft-card-snip">{{item.snippet}}</view>
        </view>
        <view class="draft-card-side">
          <view class="draft-card-time">{{item.timeText}}</view>
          <view
            class="draft-card-del"
            hover-class="draft-card-del-hover"
            data-id="{{item.id}}"
            catchtap="onTapDraftDelete"
          >撕毁</view>
        </view>
      </view>
      <view class="draft-shelf-note">点击继续写，封存寄出后草稿就会离开这里。</view>
    </view>
  </scroll-view>

  <!-- 底部固定操作栏：存草稿便签按钮（编辑态不提供）+ 主按钮（未填完整置灰） -->
  <view class="btn-bar">
    <view wx:if="{{!isEdit}}" class="btn-sec" hover-class="btn-sec-hover" bindtap="onTapSaveDraft">💾 存草稿</view>
    <view
      class="btn-primary btn-next {{canNext ? '' : 'btn-next-disabled'}}"
      hover-class="{{canNext ? 'btn-primary-hover' : 'none'}}"
      bindtap="onTapNext"
    >选主题</view>
  </view>

</view>
