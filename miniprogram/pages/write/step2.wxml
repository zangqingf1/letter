<!-- 02 · 写信第二步「选择主题」（信封随主题卡片选择，信纸版式在预览区左右滑动选择） -->
<view class="page" style="padding-top: {{statusBarHeight}}px;">

  <!-- 顶部轻导航：返回修改 + 步骤条（第二步高亮） -->
  <view class="nav">
    <view class="nav-back" hover-class="nav-back-hover" bindtap="onTapBack">‹ 返回修改</view>
    <view class="steps">
      <text class="step">写内容</text>
      <text class="step-sep">·</text>
      <text class="step on">选择主题</text>
    </view>
  </view>

  <!-- 实时预览区（占满剩余屏高）：横向滑动切换信纸版式（素笺/航空笺/笔记本/织纹笺，
       配色随所选主题）；寄出时信纸轻沉"折起" -->
  <view class="preview {{sealing ? 'preview-sealing' : ''}}" style="background: {{currentTheme.desk}};">
    <swiper class="preview-swiper" current="{{currentPaperIndex}}" bindchange="onPaperChange">
      <block wx:for="{{papers}}" wx:key="id">
        <swiper-item>
          <view class="pv-item">
            <template is="letter-view" data="{{ theme: currentTheme, paper: item, letter: letter, dateText: dateText, postmarkText: postmarkText, mode: flipping ? 'lv-flip' : '' }}" />
          </view>
        </swiper-item>
      </block>
    </swiper>
  </view>

  <!-- 信纸版式指示：当前版式名 + 圆点（点击圆点可直接切换） -->
  <view class="paper-ind">
    <view class="paper-ind-name">信纸 · <text class="paper-ind-cur">{{currentPaper.name}}</text></view>
    <view class="paper-dots">
      <view
        wx:for="{{papers}}"
        wx:key="id"
        class="paper-dot {{index === currentPaperIndex ? 'on' : ''}}"
        data-index="{{index}}"
        bindtap="onTapPaperDot"
      ></view>
    </view>
  </view>

  <!-- 信封（主题）选择区：横滑卡片流（缩略图展示信封，素材未就绪的主题用色样占位） -->
  <view class="theme-area">
    <view class="theme-label">—— 信封 · <text class="theme-name">{{currentTheme.name}}{{currentIndex === 0 ? '（默认）' : ''}}</text> ——</view>
    <scroll-view class="theme-row" scroll-x enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{themes}}"
        wx:key="id"
        class="theme-card {{index === currentIndex ? 'sel' : ''}} {{item.pending ? 'pending' : ''}}"
        data-index="{{index}}"
        bindtap="onSelectTheme"
      >
        <image wx:if="{{item.ownEnvelope}}" class="tc-img" src="{{item.envelope}}" mode="aspectFill" />
        <view wx:else class="tc-swatch" style="background: {{item.palette.base}};"></view>
        <view class="tc-name">{{item.name}}</view>
        <view class="tc-desc">{{item.desc}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- 底部火漆寄出栏 -->
  <view class="wax-wrap">
    <view class="btn-primary wax-cta {{sealing ? 'wax-sealing' : ''}}" hover-class="btn-primary-hover" bindtap="onTapSend">
      <view class="wax-amp"></view>{{editMode ? '保存修改并封存' : '封存寄出'}}
    </view>
  </view>

  <!-- 寄出完成幕（点击任意处跳过）：主题信封落定 → 固定文案，随后淡出返回信匣 -->
  <view wx:if="{{fx}}" class="send-fx {{fxOut ? 'fx-out' : ''}}" catchtap="onSkipFx">
    <view class="fx-env">
      <image class="fx-env-img" src="{{currentTheme.envelope}}" mode="aspectFill" />
    </view>
    <view class="fx-copy">{{editMode ? '已重新封存。那些新的思考，也一起安放好了。' : '已封存。未来的某一天，它会在这里等你。'}}</view>
  </view>

</view>

<!-- 信纸视图模板：版式 = papers.js 配置（su 素笺 / airmail 航空笺 / notebook 笔记本 / weave 织纹笺）。
     方案B：配色底 + 纯排版（无纸张图片）；装饰色仅固定暖色锚点（陶土 #C58A6A + 暖灰），
     任意主题 palette 下通用；长文在纸内滚动 -->
<template name="letter-content">
  <view class="lv-headline"></view>
  <view class="lv-name" style="color: {{theme.palette.title}};">{{letter.name}}</view>
  <view class="lv-tag" style="color: {{theme.palette.tag}};">【当时的问题】</view>
  <view class="lv-body lv-q" style="color: {{theme.palette.text}};">{{letter.question}}</view>
  <view class="lv-tag" style="color: {{theme.palette.tag}};">【想明白的答案】</view>
  <view class="lv-body lv-a" style="color: {{theme.palette.text}};">{{letter.answer}}</view>
  <view class="lv-date">—— 写于 {{dateText}}</view>
</template>

<template name="letter-view">
  <view class="lv {{mode}}">

    <!-- 航空笺：斜纹边框包裹整张纸，内容在内层底色卡上 -->
    <view wx:if="{{paper.id === 'airmail'}}" class="lv-paper paper-airmail">
      <view class="pv-air-inner" style="background: {{theme.palette.base}};">
        <view class="pv-air-top">
          <view class="pv-air-label">
            <text>心灵信箱</text>
            <text class="pv-air-en">PAR AVION</text>
          </view>
          <view class="pv-air-stamp">
            <view class="pv-stamp-mini" style="color: {{theme.palette.title}};">信</view>
            <view class="pv-stamp-name" style="color: {{theme.palette.tag}};">{{theme.name}}</view>
            <view class="pv-postmark">
              <view class="pv-pm-date">{{postmarkText}}</view>
            </view>
          </view>
        </view>
        <template is="letter-content" data="{{ theme: theme, letter: letter, dateText: dateText }}" />
      </view>
    </view>

    <!-- 笔记本：踩线横格 + 陶土边线 + 装订孔 -->
    <view wx:elif="{{paper.id === 'notebook'}}" class="lv-paper paper-notebook" style="background: {{theme.palette.base}};">
      <view class="pv-marginline"></view>
      <view class="pv-holes"><view></view><view></view><view></view></view>
      <template is="letter-content" data="{{ theme: theme, letter: letter, dateText: dateText }}" />
    </view>

    <!-- 织纹笺：布纹底 + 双线内框 + 四角陶土饰 -->
    <view wx:elif="{{paper.id === 'weave'}}" class="lv-paper paper-weave" style="background: {{theme.palette.base}};">
      <view class="pv-corner c-tl"></view>
      <view class="pv-corner c-tr"></view>
      <view class="pv-corner c-bl"></view>
      <view class="pv-corner c-br"></view>
      <view class="pv-weave-frame">
        <template is="letter-content" data="{{ theme: theme, letter: letter, dateText: dateText }}" />
      </view>
    </view>

    <!-- 素笺（默认）：陶土头线经典款 -->
    <view wx:else class="lv-paper paper-su" style="background: {{theme.palette.base}};">
      <template is="letter-content" data="{{ theme: theme, letter: letter, dateText: dateText }}" />
    </view>

  </view>
</template>
