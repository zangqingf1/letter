/* 04 · 分享图 · 明信片预览 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: var(--color-base-light);
}

/* ── 顶部轻导航 ── */
.nav {
  position: relative;
  flex: none;
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}
.nav-back {
  font-size: 28rpx;
  color: var(--color-text-primary);
  padding: 8rpx 0;
}
.nav-back-hover {
  opacity: 0.6;
}
.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-family: var(--font-heading);
  font-size: 30rpx;
  font-weight: 700;
}

/* ── 明信片预览区：配色信纸（底色 + 纯排版，高度随内容自适应）+ 小程序条，与导出图同构 ── */
.stage {
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  overflow-y: auto;
  padding: 8rpx 40rpx;
}
.postcard {
  position: relative;
  margin: auto; /* 内容不超高时水平垂直居中，超高时可滚动预览（flex margin auto 居中不裁顶） */
  /* 宽 630rpx；高度随信纸内容自适应，底部小程序条 88rpx */
  width: 630rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 36rpx rgba(80, 100, 90, 0.18);
  display: flex;
  flex-direction: column;
  background: #EDE9DC;
}
/* 信纸主体：主题配色底 + 纯排版（素笺基准尺寸与导出图同源：边距 12% / 上 10% / 下 8%） */
.pc-paper {
  padding: 64rpx 76rpx 52rpx;
  box-sizing: border-box;
}
.pc-content {
  padding: 0;
}
/* 信纸头线（陶土色，与写信/详情页 headline 同源） */
.pc-headline {
  border-top: 4rpx solid #C58A6A;
  margin-bottom: 24rpx;
}
.pc-title {
  font-family: var(--font-heading);
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  color: #5A4F3E;
  margin-bottom: 8rpx;
}
.pc-hand {
  font-family: var(--font-hand);
  font-size: 28rpx;
  line-height: 1.8;
  letter-spacing: 0.5rpx;
  color: #4A4438;
  white-space: pre-wrap;
}
.pc-q {
  margin-top: 16rpx;
}
.pc-a {
  margin-top: 32rpx;
}
.pc-date {
  margin-top: 40rpx;
  font-size: 22rpx;
  color: #9A9284;
  text-align: right;
}
/* 无障碍：关闭手写体开关生效时回落到系统字体（与全局设置一致） */
.hand-off .pc-hand {
  font-family: var(--font-ui);
  letter-spacing: 0;
}

/* ── 信纸版式（papers.js）：素笺为默认；装饰色仅固定暖色锚点（陶土 #C58A6A + 暖灰
   派生透明度），不依赖主题配色，任意主题底色下通用；无纯黑、无冷灰阴影 ── */
/* 航空笺：斜纹边框包裹整纸，内容在内层底色卡 */
.pc-paper.paper-airmail {
  padding: 14rpx;
  background: repeating-linear-gradient(
    -45deg,
    rgba(197, 138, 106, 0.38) 0 16rpx,
    transparent 16rpx 30rpx,
    rgba(125, 133, 128, 0.3) 30rpx 58rpx,
    transparent 58rpx 88rpx
  );
}
.pc-air-inner {
  border-radius: 8rpx;
  overflow: hidden;
}
.pc-air-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin: 34rpx 44rpx 0;
}
.paper-airmail .pc-content {
  padding: 16rpx 76rpx 52rpx;
}
.pc-air-label {
  font-family: var(--font-ui);
  font-size: 20rpx;
  color: #9A9284;
  letter-spacing: 4rpx;
  line-height: 1.7;
  text-align: center;
  border: 2rpx solid rgba(125, 133, 128, 0.45);
  border-radius: 6rpx;
  padding: 8rpx 18rpx;
}
.pc-air-label text {
  display: block;
}
.pc-air-en {
  font-size: 16rpx;
  letter-spacing: 2rpx;
}
.pc-air-stamp {
  position: relative;
  flex: none;
  width: 120rpx;
  height: 138rpx;
  border: 2rpx dashed rgba(125, 133, 128, 0.55);
  border-radius: 4rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}
.pc-stamp-mini {
  width: 48rpx;
  height: 60rpx;
  background: rgba(197, 138, 106, 0.28);
  border-radius: 4rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-heading);
  font-size: 26rpx;
  font-weight: 700;
}
.pc-stamp-name {
  font-size: 18rpx;
  letter-spacing: 2rpx;
}
.pc-postmark {
  position: absolute;
  right: -36rpx;
  top: 32rpx;
  width: 100rpx;
  height: 100rpx;
  border: 3rpx solid rgba(125, 133, 128, 0.75);
  border-radius: 50%;
  transform: rotate(-12deg);
  opacity: 0.85;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pc-postmark::after {
  content: "";
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 8rpx;
  bottom: 8rpx;
  border: 2rpx solid rgba(125, 133, 128, 0.5);
  border-radius: 50%;
}
.pc-pm-date {
  font-family: var(--font-heading);
  font-size: 22rpx;
  font-weight: 700;
  color: #7D8580;
  letter-spacing: 2rpx;
}
/* 航空笺「问 / 答」引导词 */
.paper-airmail .pc-q::before,
.paper-airmail .pc-a::before {
  font-family: var(--font-ui);
  font-size: 20rpx;
  color: #9A9284;
  letter-spacing: 2rpx;
}
.paper-airmail .pc-q::before {
  content: "问 / ";
}
.paper-airmail .pc-a::before {
  content: "答 / ";
}

/* 笔记本：踩线横格（28rpx·1.8 = 50.4rpx 行盒，格线落在基线下方）+ 陶土边线 + 装订孔 */
.pc-paper.paper-notebook {
  position: relative;
  padding: 64rpx 76rpx 52rpx 128rpx;
}
.pc-marginline {
  position: absolute;
  left: 92rpx;
  top: 0;
  bottom: 0;
  width: 3rpx;
  background: rgba(197, 138, 106, 0.55);
}
.pc-holes {
  position: absolute;
  left: 32rpx;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
}
.pc-holes view {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: rgba(80, 100, 90, 0.1);
  box-shadow: inset 0 2rpx 4rpx rgba(80, 100, 90, 0.28);
}
.paper-notebook .pc-hand {
  background-image: repeating-linear-gradient(
    to bottom,
    transparent 0 43.4rpx,
    rgba(125, 133, 128, 0.26) 43.4rpx 45.4rpx,
    transparent 45.4rpx 50.4rpx
  );
}
.paper-notebook .pc-title {
  display: inline-block;
  text-align: left;
  border-bottom: 1rpx solid rgba(125, 133, 128, 0.4);
  padding-bottom: 8rpx;
}

/* 织纹笺：十字织纹底 + 双线内框 + 四角陶土饰 + 问/答标签 */
.pc-paper.paper-weave {
  position: relative;
  padding: 34rpx 36rpx 38rpx;
  background-image:
    repeating-linear-gradient(0deg, rgba(46, 51, 48, 0.03) 0 1rpx, transparent 1rpx 9rpx),
    repeating-linear-gradient(90deg, rgba(46, 51, 48, 0.03) 0 1rpx, transparent 1rpx 9rpx);
}
.pc-weave-frame {
  position: relative;
  border: 1rpx solid rgba(125, 133, 128, 0.38);
}
.pc-weave-frame::after {
  content: "";
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  top: 8rpx;
  bottom: 8rpx;
  border: 1rpx solid rgba(125, 133, 128, 0.18);
  pointer-events: none;
}
.paper-weave .pc-content {
  padding: 40rpx 48rpx 44rpx;
}
.pc-corner {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  z-index: 1;
}
.pc-corner::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  border: 3rpx solid #C58A6A;
  border-radius: 2rpx;
  transform: rotate(45deg);
}
.pc-corner.c-tl { top: 27rpx; left: 29rpx; }
.pc-corner.c-tr { top: 27rpx; right: 29rpx; }
.pc-corner.c-bl { bottom: 31rpx; left: 29rpx; }
.pc-corner.c-br { bottom: 31rpx; right: 29rpx; }
.paper-weave .pc-hand::before {
  font-family: var(--font-ui);
  font-size: 20rpx;
  color: #9A9284;
  border: 1rpx solid rgba(125, 133, 128, 0.5);
  border-radius: 4rpx;
  padding: 2rpx 12rpx;
  margin-right: 14rpx;
  letter-spacing: 2rpx;
}
.paper-weave .pc-q::before {
  content: "问";
}
.paper-weave .pc-a::before {
  content: "答";
}

/* ── 品牌区：贴在信纸下方（不遮挡信纸），火漆 Logo + 品牌文案 + 小程序码 ── */
.pc-brand {
  position: relative;
  flex: none;
  z-index: 2;
  height: 88rpx;
  background: var(--color-accent-primary);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 110rpx 0 32rpx;
  box-sizing: border-box;
}.pc-logo {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  flex: none;
}
.pc-slogan {
  font-size: 20rpx;
  letter-spacing: 1rpx;
}
/* 小程序码（白色衬底保证扫码对比度） */
.pc-qr {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 62rpx;
  height: 62rpx;
  background: #FFFFFF;
  border-radius: 8rpx;
  padding: 5rpx;
  box-sizing: border-box;
}
.pc-qr-img {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 4rpx;
}

/* ── 底部操作区 ── */
.share-foot {
  flex: none;
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
}
.share-ops {
  display: flex;
  gap: 24rpx;
}
.share-btn {
  flex: 1;
  font-size: 30rpx;
}

/* ── 离屏导出画布（宽 1080，高随内容在 JS 中动态设置；不参与预览） ── */
.export-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 1080px;
  height: 1597px;
}
