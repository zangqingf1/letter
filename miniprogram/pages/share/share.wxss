/* 04 · 分享图 · 明信片预览 */
/* 信纸版式装饰与排版：共享样式（styles/paper.wxss，与写信预览/详情阅读同构） */
@import "../../styles/paper.wxss";

/* 页面背景随主题：WXML 内联绑 theme.desk，这里只是绑定缺失时的兜底 */
.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: var(--color-base-light);
}

/* ── 顶部轻导航 ── */
.nav {
  position: relative;
  flex: none;
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}
.nav-back {
  font-size: 28rpx;
  color: var(--color-text-primary);
  padding: 8rpx 0;
}
.nav-back-hover {
  opacity: 0.6;
}
.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-family: var(--font-heading);
  font-size: 30rpx;
  font-weight: 700;
}

/* ── 明信片预览区：信纸自持版式（共享模板，宽 630rpx 与导出图同源）+ 小程序条 ── */
.stage {
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  overflow-y: auto;
  padding: 8rpx 40rpx;
}
/* ── 预览区①：成品图本身（方案 A，宽 630rpx 与导出件等比）
   刻意不加 border-radius —— 加圆角就会裁掉导出件的四个角，预览就不再等于成品。
   投影只是页面外框（落在图片之外，不改变任何一个像素）。── */
.shot {
  display: block;
  width: 630rpx;
  margin: auto;
  box-shadow: 0 12rpx 36rpx rgba(80, 100, 90, 0.18);
}

/* ── 预览区②：出图骨架。纸色与文字色由页面按当前版式内联（深色纸面也能读），
   高度由 shotH 内联占位；min-height 是「还没量出成品高」时的地板，避免塌成 0。── */
.shot-sk {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 630rpx;
  min-height: 720rpx;
  margin: auto;
  padding: 40rpx;
  box-sizing: border-box;
  box-shadow: 0 12rpx 36rpx rgba(80, 100, 90, 0.18);
}
.shot-sk-tip {
  font-size: 24rpx;
  letter-spacing: 2rpx;
  animation: shot-pulse 1.5s ease-in-out infinite;
}
@keyframes shot-pulse {
  0%,
  100% {
    opacity: 0.45;
  }
  50% {
    opacity: 1;
  }
}

/* ── 预览区③：出图失败才用的降级预览（WXML 版式）── */
.postcard {
  position: relative;
  margin: auto; /* 内容不超高时水平垂直居中，超高时可滚动预览（flex margin auto 居中不裁顶） */
  /* 宽 630rpx；高度随信纸内容自适应，底部小程序条 88rpx */
  width: 630rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 36rpx rgba(80, 100, 90, 0.18);
  display: flex;
  flex-direction: column;
  background: #EDE9DC;
}
.postcard .pl {
  flex: 1 1 auto;
}

/* ── 品牌区：贴在信纸下方（不遮挡信纸），火漆 Logo + 品牌文案 + 小程序码 ── */
.pc-brand {
  position: relative;
  flex: none;
  z-index: 2;
  height: 88rpx;
  background: var(--color-accent-primary);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 110rpx 0 32rpx;
  box-sizing: border-box;
}.pc-logo {
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  flex: none;
}
.pc-slogan {
  font-size: 20rpx;
  letter-spacing: 1rpx;
}
/* 小程序码（白色衬底保证扫码对比度） */
.pc-qr {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 62rpx;
  height: 62rpx;
  background: #FFFFFF;
  border-radius: 8rpx;
  padding: 5rpx;
  box-sizing: border-box;
}
.pc-qr-img {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 4rpx;
}

/* ── 底部操作区 ── */
.share-foot {
  flex: none;
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
}
.share-ops {
  display: flex;
  gap: 24rpx;
}
.share-btn {
  flex: 1;
  font-size: 30rpx;
}

/* ── 离屏导出画布（宽 1080，高随内容在 JS 中动态设置；不参与预览） ── */
.export-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 1080px;
  height: 1597px;
}
