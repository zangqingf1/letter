/* 11 · 会员中心：会员状态卡 + 权益清单 + 专属主题/版式 + 订阅半屏拉手 */
@import "../../styles/paper.wxss";
.page {
  box-sizing: border-box;
  min-height: 100vh;
  background: var(--color-base-light);
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

/* ── 顶部轻导航（与账号管理页同款） ── */
.nav {
  position: relative;
  flex: none;
  height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}
.nav-back {
  font-size: 28rpx;
  color: var(--color-text-primary);
  padding: 8rpx 0;
}
.nav-back-hover {
  opacity: 0.6;
}
.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-family: var(--font-heading);
  font-size: 32rpx;
  font-weight: 700;
}
.page-note {
  margin: 8rpx 32rpx 20rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  letter-spacing: 2rpx;
}

/* ── 区块小标签 ── */
.section-label {
  margin: 44rpx 40rpx 0;
  font-size: 20rpx;
  color: var(--color-text-secondary);
  letter-spacing: 4rpx;
}

/* ── 会员状态卡 ── */
.status-card {
  margin: 12rpx 32rpx 0;
  border-radius: 36rpx;
  padding: 40rpx 32rpx 32rpx;
  box-shadow: var(--shadow-warm-sm);
  overflow: hidden;
}
/* 未开通：虚线描边 + 米白底 */
.status-card.free {
  background: var(--color-base-surface);
  border: 2rpx dashed var(--color-disabled);
  box-sizing: border-box;
}
.status-free-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.status-free-title {
  font-family: var(--font-heading);
  font-size: 42rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}
.status-seal {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-heading);
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
.seal-plain {
  color: var(--color-disabled);
  border: 2rpx dashed var(--color-disabled);
}
.status-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--color-text-secondary);
}
.status-points {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 28rpx;
}
.status-point {
  font-size: 24rpx;
  color: var(--color-text-primary);
}
.status-btn {
  margin-top: 32rpx;
}

/* 会员态未定（首帧无缓存）：中性骨架 —— 与未开通卡同形同高，回源落地后原位替换，版面不跳动 */
.status-card.loading {
  background: var(--color-base-surface);
  border: 2rpx dashed var(--color-disabled);
  box-sizing: border-box;
}
.skeleton {
  background: var(--color-base-light);
  border-radius: 8rpx;
  animation: skeleton-breath 1.4s ease-in-out infinite;
}
.sk-title {
  width: 320rpx;
  height: 46rpx;
  border-radius: 12rpx;
}
.sk-seal {
  flex: none;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
}
.sk-desc {
  margin-top: 20rpx;
  width: 460rpx;
  height: 26rpx;
}
.sk-point {
  flex: none;
  width: 200rpx;
  height: 24rpx;
  border-radius: 6rpx;
}
.sk-btn {
  margin-top: 32rpx;
  width: 100%;
  height: 96rpx;
  border-radius: 52rpx;
}
@keyframes skeleton-breath {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}

/* 已开通：暖金光影卡面 */
.status-card.vip {
  background: linear-gradient(135deg, #C4A482, #A98C68 55%, #8F7350);
  box-shadow: 0 12rpx 32rpx rgba(150, 120, 70, 0.28);
}
/* 左上角：头像 + 昵称（替换原 VIP 火漆与等级，点按进账号管理） */
.status-vip-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  color: #FDFAF3;
  margin-bottom: 28rpx;
}
.status-vip-head .avatar {
  flex: none;
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(253, 250, 243, 0.16);
  border: 2rpx solid rgba(253, 250, 243, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
}
.status-vip-head .avatar-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 88rpx;
  height: 88rpx;
  display: block;
}
.status-vip-head .avatar-char {
  font-family: var(--font-heading);
  font-size: 40rpx;
  font-weight: 700;
  color: #FDFAF3;
}
.status-vip-head .status-vip-name {
  flex: 1;
  min-width: 0;
  font-family: var(--font-heading);
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #FDFAF3;
}
.status-vip-head-hover {
  opacity: 0.85;
}
.seal-gold {
  background: rgba(253, 250, 243, 0.16);
  border: 2rpx solid rgba(253, 250, 243, 0.7);
  color: #FDFAF3;
}
.status-vip-level {
  flex: 1;
  font-family: var(--font-heading);
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}
.status-vip-tag {
  font-size: 22rpx;
  color: rgba(253, 250, 243, 0.82);
  padding: 6rpx 18rpx;
  border-radius: 30rpx;
  background: rgba(253, 250, 243, 0.14);
}
.status-vip-meta {
  margin-top: 28rpx;
  display: flex;
  gap: 32rpx;
}
.meta-item {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.meta-label {
  font-size: 20rpx;
  color: rgba(253, 250, 243, 0.7);
}
.meta-value {
  font-size: 26rpx;
  color: #FDFAF3;
}
.status-card.vip .status-btn {
  margin-top: 36rpx;
}

/* ── 权益清单 ── */
.benefit-list {
  margin: 20rpx 32rpx 0;
  background: var(--color-base-surface);
  border-radius: 28rpx;
  box-shadow: var(--shadow-warm-sm);
  padding: 8rpx 28rpx;
}
.benefit-item {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 30rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.benefit-item:last-child {
  border-bottom: none;
}
.benefit-icon {
  flex: none;
  font-size: 36rpx;
}
.benefit-body {
  flex: 1;
  min-width: 0;
}
.benefit-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}
.benefit-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}
.benefit-badge {
  flex: none;
  font-size: 20rpx;
  color: var(--color-text-secondary);
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  border: 2rpx solid var(--line);
}
.benefit-badge.on {
  color: #8F7350;
  border-color: #C4A482;
  background: rgba(196, 164, 130, 0.12);
}

/* ── 会员专属 · 自定义主题与版式 ── */
.show-group {
  margin: 24rpx 32rpx 0;
}
.show-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin: 8rpx 8rpx 20rpx;
}
.show-scroll {
  white-space: nowrap;
}
.show-row {
  display: inline-flex;
  gap: 24rpx;
  padding: 4rpx;
}
.show-card {
  position: relative;
  width: 240rpx;
  flex: none;
  padding: 16rpx;
  background: var(--color-base-surface);
  border-radius: 24rpx;
  box-shadow: var(--shadow-warm-sm);
}
.paper-preview {
  position: relative;
  width: 100%;
  height: 150rpx;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.paper-line {
  width: 56rpx;
  height: 4rpx;
  border-radius: 4rpx;
  opacity: 0.6;
}
.paper-text {
  margin-top: 14rpx;
  font-family: var(--font-heading);
  font-size: 30rpx;
  font-weight: 700;
}
/* 信封预览：有真实信封素材的显示真实图；否则用 swatch 色样（与写信第二步同口径） */
.theme-preview {
  position: relative;
  width: 100%;
  height: 150rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.theme-preview-img {
  width: 100%;
  height: 150rpx;
  border-radius: 16rpx;
  display: block;
}
.show-name {
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}
.show-desc {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--color-text-secondary);
}
.show-state {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  background: rgba(254, 252, 244, 0.9);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}
.show-state.unlocked {
  color: #8F7350;
  border: 2rpx solid #C4A482;
}

/* ── 订阅半屏拉手 ── */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(30, 34, 32, 0.42);
  z-index: 90;
  opacity: 1;
  transition: opacity 0.2s ease;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: var(--color-base-light);
  border-radius: 40rpx 40rpx 0 0;
  padding: 16rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  transform: translateY(105%);
  transition: transform 0.26s ease-out;
  box-shadow: 0 -12rpx 40rpx rgba(0, 0, 0, 0.12);
}
.sheet.sheet-open {
  transform: translateY(0);
}
.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: var(--color-disabled);
  margin: 0 auto 24rpx;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sheet-title {
  font-family: var(--font-heading);
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}
.sheet-close {
  font-size: 34rpx;
  color: var(--color-text-secondary);
  padding: 8rpx 12rpx;
}
.plan-list {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.plan-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  border-radius: 24rpx;
  border: 2rpx solid var(--line);
  background: var(--color-base-surface);
}
.plan-item.plan-active {
  border-color: var(--color-accent-primary);
  background: rgba(107, 142, 133, 0.08);
}
.plan-main {
  flex: 1;
  min-width: 0;
}
.plan-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}
.plan-tag {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}
.plan-price {
  font-family: var(--font-hand);
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-accent-secondary);
}
.plan-unit {
  font-size: 28rpx;
}
.plan-period {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--color-text-secondary);
}
.agree {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 8rpx 4rpx;
}
.agree-check {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid var(--color-disabled);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: var(--color-base-light);
  box-sizing: border-box;
}
.agree-check-on {
  background: var(--color-accent-primary);
  border-color: var(--color-accent-primary);
}
.agree-text {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}
.agree-link {
  color: var(--color-accent-primary);
}
.sheet-btn {
  margin-top: 32rpx;
}
.sheet-note {
  margin-top: 20rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--color-text-secondary);
  opacity: 0.8;
}

/* ── 开通成功完成幕 ── */
.success {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(244, 243, 238, 0.97);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  animation: success-fade 0.3s ease;
}
@keyframes success-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}
.success-seal {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: var(--color-accent-primary);
  color: var(--color-base-light);
  font-size: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(107, 142, 133, 0.3);
}
.success-title {
  margin-top: 36rpx;
  font-family: var(--font-heading);
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}
.success-desc {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}
.success-tap {
  position: absolute;
  bottom: 80rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  opacity: 0.7;
}

/* ── 专属信纸示例预览：真实版式模板渲染（与写信第二步/详情同构），点遮罩关闭 ── */
.sample-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 60;
  background: rgba(20, 18, 14, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
}
.sample-stage {
  width: 650rpx;
  max-height: 68vh;
  box-sizing: border-box;
  border-radius: 20rpx;
  padding: 20rpx 10rpx;
  overflow-y: auto;
  display: flex;
  justify-content: center;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.28);
}
.sample-bar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 61;
  background: #FFFDF8;
  padding: 24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}
.sample-name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 18rpx;
}
.sample-btn {
  width: 100%;
}
.sample-close {
  margin-top: 18rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}
