<!-- 01 · 首页 · 信匣（三个状态：空态 / 1–6 封随机倾斜 / ≥7 封整齐网格） -->
<view class="page" style="padding-top: {{statusBarHeight}}px;">

  <!-- 顶部品牌区：logo + 名称 -->
  <view class="home-head">
    <image class="logo" src="/assets/logo.png" mode="aspectFit" />
    <image class="brand-name" src="/assets/name.png" mode="aspectFit" />
  </view>

  <!-- 冷启动骨架（initialRenderingCache static 首帧，仅首次加载显示；色块占位 + 轻呼吸，无其他动效） -->
  <block wx:if="{{loading}}">
    <view class="today sk-card">
      <view class="sk sk-label"></view>
      <view class="sk-row">
        <view class="sk-lines">
          <view class="sk sk-line"></view>
          <view class="sk sk-line sk-line-short"></view>
        </view>
        <view class="sk sk-img"></view>
      </view>
    </view>
    <view class="desk">
      <view class="letters letters-few">
        <view
          class="letter-card"
          wx:for="{{[0, 1, 2, 3]}}"
          wx:key="*this"
          style="transform: rotate({{item % 2 ? 2 : -2}}deg);"
        >
          <view class="sk sk-env"></view>
          <view class="sk sk-name"></view>
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
  <!-- 今日来信 -->
  <view class="today {{hasLetters ? '' : 'today-empty'}}" bindtap="onTapTodayLetter">
    <view class="t-label">今日来信</view>
    <block wx:if="{{todayLetter}}">
      <view class="t-row">
        <view class="t-text">今天有一封来自 <text class="em">{{todayLetter.dateText}}</text> 的信，是过去的你写给自己的答案。</view>
        <view class="t-img-wrap">
          <view class="t-img">
            <image class="t-img-src" src="{{todayLetter.env}}" mode="aspectFill" />
          </view>
          <view class="stamp">
            <view class="stamp-waves">
              <view class="wave"></view>
              <view class="wave"></view>
              <view class="wave"></view>
            </view>
            <view class="stamp-seal">
              <text class="stamp-brand">心灵信箱</text>
              <text class="stamp-date">{{todayStamp}}</text>
              <text class="stamp-year">{{todayYear}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>
    <block wx:else>
      <view class="t-text t-text-center">还没有信寄给你。</view>
      <view class="t-text t-text-center em">写下的第一个答案，会在未来的某天等你。</view>
    </block>
  </view>

  <!-- 新用户福利横幅（纯引导）：服务端判定 trialAvailable 才显示，点击去会员中心领取 -->
  <view wx:if="{{trialAvailable}}" class="trial-banner" hover-class="trial-banner-hover" bindtap="onTapTrialBanner">
    <text class="trial-banner-emoji">🎁</text>
    <view class="trial-banner-text">
      <view class="trial-banner-title">新用户福利 · 3 天体验会员</view>
      <view class="trial-banner-sub">全部专属信纸与信封随便用，去会员中心领取</view>
    </view>
    <view class="trial-banner-go">›</view>
  </view>

  <!-- 会员过期横幅：服务端 expired 标记才显示（与从未开通区分）；点击进会员中心，点一次即消失 -->
  <view wx:if="{{memberExpiredBanner}}" class="expired-banner" hover-class="expired-banner-hover" bindtap="onTapExpiredBanner">
    <text class="expired-banner-emoji">🕯️</text>
    <view class="expired-banner-text">
      <view class="expired-banner-title">会员已过期</view>
      <view class="expired-banner-sub">专属信纸与信封已回落为默认款，去会员中心重新点亮</view>
    </view>
    <view class="expired-banner-go">›</view>
  </view>

  <!-- 草稿横条（条件触发） -->
  <view wx:if="{{draftCount > 0 && hasLetters}}" class="draft-bar" bindtap="onTapDrafts">
    <text class="draft-emoji">📝</text> 有 <text class="draft-num">{{draftCount}}</text> 封没写完的信，点此处继续写
  </view>

  <!-- 状态一：空状态（0 封） -->
  <block wx:if="{{!hasLetters}}">
    <view class="empty-illust">
      <image class="empty-mailbox" src="/assets/mailbox.png" mode="aspectFit" />
    </view>
    <view class="empty-txt">
      匣子还空着。第一个写下来的答案，
    </view>
    <view class="empty-txt">会在未来某天，<text class="em">恰好接住那时的你。</text></view>
    <view class="center-cta">
      <view class="btn-primary" hover-class="btn-primary-hover" bindtap="onTapWrite">✍️ 写第一封信</view>
    </view>
  </block>

  <!-- 状态二 / 状态三：信匣网格 -->
  <view wx:else class="desk">
    <view class="letters {{isTidy ? 'letters-tidy' : 'letters-few'}}">
      <view
        class="letter-card {{item.arriving ? 'arrive' : ''}}"
        wx:for="{{letters}}"
        wx:key="id"
        style="transform: rotate({{item.tilt}}deg);"
        data-id="{{item.id}}"
        hover-class="letter-card-hover"
        bindtap="onTapLetter"
      >
        <view class="env-wrap">
          <!-- 信封不做进入视口懒加载：点开视口外的信时，云端主题的缩略图必须已在缓存里，
               否则拆信幕首帧无图可命中（见 detail.js envPatchOf） -->
          <image class="env-img" src="{{item.env}}" mode="aspectFill" />
          <view wx:if="{{item.pinned}}" class="clip-wrap">
            <image class="clip" src="/assets/clip.png" mode="aspectFit" />
          </view>
        </view>
        <view class="env-name">{{item.name}}</view>
      </view>
    </view>
    <view wx:if="{{isTidy}}" class="desk-hint">— 轻触卡片即可拆开 —</view>
  </view>

  <!-- 右下角悬浮写信入口（手绘信箱，空态时隐藏，入口由"写第一封信"按钮承担） -->
  <view wx:if="{{hasLetters}}" class="float-write" hover-class="float-write-hover" bindtap="onTapWrite">
    <image class="float-mailbox" src="/assets/mailbox.png" mode="aspectFit" />
  </view>
  </block>

  <!-- 点开信件时的信封预取节点（见 openDetail）：屏幕外挂载只为触发下载，图片缓存按 URL
       全局共享，详情页拆信幕的两级 src 因此大概率直接命中，不必从点击那一刻才开始走
       「fileID→临时URL→下载」 -->
  <image wx:if="{{preEnv}}" class="env-pre" src="{{preEnv}}" />
  <image wx:if="{{preEnvFull}}" class="env-pre" src="{{preEnvFull}}" bindload="onPreEnvFullLoad" />
  <!-- 批量预取（见 prefetchAllEnvFull）：信匣数据就绪后逐张下载列表涉及的信封大图 -->
  <image wx:if="{{bgEnvFull}}" class="env-pre" src="{{bgEnvFull}}" bindload="onBgEnvFullLoad" />

</view>
